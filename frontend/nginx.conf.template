server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Hardening headers. always applies them to error responses too, which the
    # default omits. The CSP allows the app's own assets plus XHR to the API
    # origin; ${VITE_API_URL} is substituted at container start from the same
    # value the bundle was built against.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ${VITE_API_URL}; frame-ancestors 'none'; base-uri 'self'" always;

    # Single-page app: unknown paths must fall back to index.html so that
    # /privacidade and /termos resolve on a hard refresh instead of 404ing.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hashed build assets are immutable; index.html must never be cached or
    # users keep loading a stale bundle after a deploy.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
