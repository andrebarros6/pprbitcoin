# Database
# Local development (no Docker needed):
DATABASE_URL=sqlite:///./pprbitcoin.db
# Local Postgres via docker-compose:
# DATABASE_URL=postgresql://pprbitcoin:pprbitcoin_dev_password@localhost:5432/pprbitcoin
# On Railway this is injected automatically by the Postgres plugin.

# API Configuration
API_VERSION=v1
API_TITLE=PPR Bitcoin API
API_DESCRIPTION=API para analise de portfolios PPR + Bitcoin
# Never enable in production: leaks stack traces and logs every SQL statement.
DEBUG=True

# CORS - comma separated. Must include the deployed frontend origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting (requests per minute, per IP, on calculation endpoints)
RATE_LIMIT_PER_MINUTE=100

# Set to True to run scheduled data refreshes inside the API process.
ENABLE_SCHEDULER=False

# Sentry (Error Monitoring) - optional
SENTRY_DSN=

# Timezone
TZ=Europe/Lisbon
